# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Comma-separated list of allowed origins for CORS (the web prototype runs on Vite, port 8443 by default)
CORS_ORIGINS=http://localhost:8443,http://localhost:5173

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cloud

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Payments ---
# "mock" — no real charges (development); "stripe" — real charges via Stripe (Apple Pay / Google Pay / cards)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Push notifications ---
# "log" — print to console; "expo" — send via Expo Push API (React Native / Expo clients)
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=

# --- Background worker ---
# Run the worker (session auto-complete, wind-down reminders) inside the API process
RUN_WORKER=true
WORKER_INTERVAL_SECONDS=30
